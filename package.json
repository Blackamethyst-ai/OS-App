    "prebuild": "npm run build:libs && npm run scan:codebase",
    "start": "serve -s dist -l 8080",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@antigravity/agent-core-sdk": "file:./libs/agent-core-sdk",
