    "@metaventionsai/voice-nexus": "file:./libs/voice-nexus",
    "@react-three/fiber": "^9.5.0",
    "@ricky0123/vad-web": "^0.0.22",
    "@supabase/supabase-js": "^2.97.0",
    "@testing-library/dom": "^10.4.1",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "face-api.js": "^0.20.0",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
