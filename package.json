{
  "name": "metaventions-ai-v1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:lattice": "tsx scripts/sync_code_graph.ts",
    "scan:codebase": "node scripts/scan-codebase-voice.cjs ./ --output ./public/codebase_graph.json",
